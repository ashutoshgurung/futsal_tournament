generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  user
  organizer
  scorekeeper
  player

  @@map("user_role")
}

model Organization {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String       @unique
  plan         String       @default("free")
  logoUrl      String?      @map("logo_url")
  contactEmail String?      @map("contact_email")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  users        User[]
  tournaments  Tournament[]
  teams        Team[]
  players      Player[]
  matches      Match[]
  tieSheets    TieSheet[]

  @@map("organizations")
}

model EmailVerificationToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_email_tokens_user")
  @@map("email_verification_tokens")
}

model User {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  email              String                   @unique
  passwordHash       String?                  @map("password_hash")
  googleId           String?                  @unique @map("google_id")
  avatarUrl          String?                  @map("avatar_url")
  role               UserRole                 @default(user)
  isActive           Boolean                  @default(true) @map("is_active")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  emailVerified      Boolean                  @default(false) @map("email_verified")
  emailVerifiedAt    DateTime?                @map("email_verified_at") @db.Timestamptz(6)
  verificationTokens EmailVerificationToken[]
  organizationId     String?                  @map("organization_id") @db.Uuid
  organization       Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([organizationId], map: "idx_users_org")
  @@map("users")
}

model Tournament {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String       @map("organization_id") @db.Uuid
  name                String
  slug                String
  description         String?
  format              String       @default("league") // league | knockout | league_knockout
  status              String       @default("draft")
  startDate           DateTime?    @map("start_date") @db.Timestamptz(6)
  endDate             DateTime?    @map("end_date") @db.Timestamptz(6)
  venue               String?
  pointsWin           Int          @default(3) @map("points_win")
  pointsDraw          Int          @default(1) @map("points_draw")
  pointsLoss          Int          @default(0) @map("points_loss")
  halfDurationMinutes Int          @default(20) @map("half_duration_minutes")
  fixturesGenerated   Boolean      @default(false) @map("fixtures_generated")
  maxTeams            Int?         @map("max_teams")
  imageUrl            String?      @map("image_url")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teams               Team[]
  matches             Match[]
  tieSheets           TieSheet[]

  @@unique([organizationId, slug])
  @@index([organizationId], map: "idx_tournaments_org")
  @@map("tournaments")
}

// ─────────────────────────────────────────────
// TIE SHEET (knockout bracket / draw sheet)
// ─────────────────────────────────────────────
model TieSheet {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  tournamentId    String          @map("tournament_id") @db.Uuid
  name            String          @default("Main Draw")
  type            String          @default("single_elimination") // single_elimination | double_elimination
  seedingMethod   String          @default("random") @map("seeding_method") // random | manual | seeded
  bracketSize     Int             @map("bracket_size") // next power of 2 (4, 8, 16, 32...)
  totalRounds     Int             @map("total_rounds")
  thirdPlaceMatch Boolean         @default(false) @map("third_place_match")
  isPublished     Boolean         @default(false) @map("is_published")
  isLocked        Boolean         @default(false) @map("is_locked") // lock once play starts
  generatedAt     DateTime?       @map("generated_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tournament      Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  entries         TieSheetEntry[]
  matches         Match[]

  @@unique([tournamentId, name])
  @@index([organizationId], map: "idx_tiesheets_org")
  @@index([tournamentId], map: "idx_tiesheets_tournament")
  @@map("tie_sheets")
}

// A team's slot/seed on the tie sheet
model TieSheetEntry {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tieSheetId String   @map("tie_sheet_id") @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  seed       Int? // seed number (1 = top seed)
  slot       Int // position in first round (1..bracketSize)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tieSheet   TieSheet @relation(fields: [tieSheetId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tieSheetId, teamId])
  @@unique([tieSheetId, slot])
  @@index([teamId], map: "idx_tiesheet_entries_team")
  @@map("tie_sheet_entries")
}

model Team {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  tournamentId    String          @map("tournament_id") @db.Uuid
  name            String
  shortName       String?         @map("short_name")
  logoUrl         String?         @map("logo_url")
  managerName     String?         @map("manager_name")
  managerPhone    String?         @map("manager_phone")
  managerEmail    String?         @map("manager_email")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tournament      Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  players         Player[]
  team1Matches    Match[]         @relation("Team1")
  team2Matches    Match[]         @relation("Team2")
  wonMatches      Match[]         @relation("Winner")
  events          MatchEvent[]
  tieSheetEntries TieSheetEntry[]

  @@unique([tournamentId, name])
  @@index([organizationId], map: "idx_teams_org")
  @@map("teams")
}

model Player {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  teamId         String       @map("team_id") @db.Uuid
  name           String
  jerseyNumber   Int          @map("jersey_number")
  position       String?
  dateOfBirth    DateTime?    @map("date_of_birth") @db.Date
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  events         MatchEvent[]

  @@unique([teamId, jerseyNumber])
  @@index([organizationId], map: "idx_players_org")
  @@map("players")
}

model Match {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seq            BigInt  @default(autoincrement())
  organizationId String  @map("organization_id") @db.Uuid
  tournamentId   String  @map("tournament_id") @db.Uuid
  round          Int
  roundName      String? @map("round_name") // e.g. "Quarter Final", "Semi Final", "Final"

  // Team 1 / Team 2 (nullable: a knockout slot stays TBD until feeder match finishes)
  team1Id      String? @map("team1_id") @db.Uuid
  team2Id      String? @map("team2_id") @db.Uuid
  team1Score   Int     @default(0) @map("team1_score")
  team2Score   Int     @default(0) @map("team2_score")
  penaltyTeam1 Int?    @map("penalty_team1")
  penaltyTeam2 Int?    @map("penalty_team2")
  winnerId     String? @map("winner_id") @db.Uuid
  isBye        Boolean @default(false) @map("is_bye")

  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(6)
  court       String?
  status      String    @default("scheduled")

  // Tie sheet / bracket linkage (all null for plain league fixtures)
  tieSheetId       String? @map("tie_sheet_id") @db.Uuid
  matchNumber      Int?    @map("match_number") // "Match 5" printed on the sheet
  bracketPosition  Int?    @map("bracket_position") // vertical order within the round
  nextMatchId      String? @map("next_match_id") @db.Uuid
  nextMatchSlot    Int?    @map("next_match_slot") // 1 = winner becomes team1, 2 = team2
  loserNextMatchId String? @map("loser_next_match_id") @db.Uuid // for 3rd-place match
  loserNextSlot    Int?    @map("loser_next_slot")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tournament     Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  team1          Team?        @relation("Team1", fields: [team1Id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  team2          Team?        @relation("Team2", fields: [team2Id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  winner         Team?        @relation("Winner", fields: [winnerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  tieSheet       TieSheet?    @relation(fields: [tieSheetId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nextMatch      Match?       @relation("WinnerProgression", fields: [nextMatchId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  feederMatches  Match[]      @relation("WinnerProgression")
  loserNextMatch Match?       @relation("LoserProgression", fields: [loserNextMatchId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  loserFeeders   Match[]      @relation("LoserProgression")
  events         MatchEvent[]

  @@unique([tieSheetId, matchNumber])
  @@index([tournamentId, round], map: "idx_matches_tournament_round")
  @@index([tournamentId, status], map: "idx_matches_tournament_status")
  @@index([organizationId, scheduledAt], map: "idx_matches_org_date")
  @@index([team1Id], map: "idx_matches_team1")
  @@index([team2Id], map: "idx_matches_team2")
  @@index([tieSheetId, round, bracketPosition], map: "idx_matches_tiesheet_round_pos")
  @@map("matches")
}

model MatchEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId   String   @map("match_id") @db.Uuid
  type      String
  teamId    String   @map("team_id") @db.Uuid
  playerId  String?  @map("player_id") @db.Uuid
  minute    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  player    Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([matchId], map: "idx_events_match")
  @@index([playerId], map: "idx_events_player")
  @@map("match_events")
}
