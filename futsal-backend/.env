PORT=5000
NODE_ENV=development

# Neon: Console -> your project -> Dashboard -> "Connect" -> copy the connection string.
# Use the POOLED string (host contains "-pooler") for API traffic.
# Use the unpooled/direct string (no "-pooler") for Prisma migrations.
# DATABASE_URL_UNPOOLED is also accepted instead of DIRECT_URL.
DIRECT_URL=
DATABASE_URL=postgresql://neondb_owner:npg_QcKtZoO14Myl@ep-mute-bird-ahh4qdkj-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Comma-separated origins, or * (Flutter mobile ignores CORS; Flutter Web needs it)
CORS_ORIGINS=*