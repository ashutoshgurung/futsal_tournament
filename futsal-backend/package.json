{
  "name": "futsal-saas-backend-neon",
  "version": "2.0.0",
  "description": "Multi-tenant futsal tournament management API (Express + Neon PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "migrate": "node src/db/migrate.js",
    "migrate:dev": "node src/db/migrate.js dev",
    "seed": "node src/db/seed.js",
    "clean": "node -e \"require('fs').rmSync('node_modules/.prisma',{recursive:true,force:true})\"",
    "clean:all": "node -e \"['node_modules','package-lock.json'].forEach(p=>require('fs').rmSync(p,{recursive:true,force:true}))\"",
    "reset": "npm run clean:all && npm install && npm run prisma:generate"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.0.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "prisma": "^6.19.3",
    "sharp": "^0.35.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
